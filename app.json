{
  "expo": {
    "name": "TrailSafe",
    "slug": "trailsafe",
    "version": "0.5.2",
    "orientation": "portrait",
    "icon": "./assets/images/trailsafe-icon.png",
    "scheme": "trailsafe",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TrailSafe shows your GPS coordinates so you can read or share them with emergency responders. Your location is not monitored or saved.",
        "NSLocationTemporaryUsageDescriptionDictionary": {
          "ExpoLocationFullAccuracy": "TrailSafe needs precise GPS coordinates so you can share an accurate location with 911 and search-and-rescue responders."
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "org.adventureleader.trailsafe",
      "buildNumber": "5"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B3A2E",
        "foregroundImage": "./assets/images/trailsafe-mark.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "org.adventureleader.trailsafe",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "versionCode": 5
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/trailsafe-icon.png"
    },
    "plugins": [
      "./plugins/with-ios-scenes.cjs",
      "./plugins/with-app-intents.cjs",
      "./plugins/with-release-diagnostics.cjs",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/barlow-condensed/600SemiBold/BarlowCondensed_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/public-sans/400Regular/PublicSans_400Regular.ttf",
            "./node_modules/@expo-google-fonts/public-sans/500Medium/PublicSans_500Medium.ttf",
            "./node_modules/@expo-google-fonts/public-sans/700Bold/PublicSans_700Bold.ttf"
          ]
        }
      ],
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B3A2E",
          "image": "./assets/images/trailsafe-mark.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TrailSafe shows your GPS coordinates so you can read or share them with emergency responders. Your location is not monitored or saved.",
          "locationFullAccuracyPermission": "TrailSafe needs precise GPS coordinates so you can share an accurate location with 911 and search-and-rescue responders.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "motionUsagePermission": false
        }
      ],
      "./plugins/with-no-push.cjs"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0e9f0b72-eb3b-4be2-840d-2f1b632e2b6f"
      },
      "bugsnag": {
        "apiKey": "2e086cc635107ef068c55e1ff704d12a"
      },
      "releaseChannel": "production"
    },
    "owner": "applied-interactions",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0e9f0b72-eb3b-4be2-840d-2f1b632e2b6f",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
