{
  "name": "trailsafe",
  "main": "expo-router/entry",
  "version": "0.5.2",
  "dependencies": {
    "@bugsnag/react-native": "^9.1.0",
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@expo-google-fonts/public-sans": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/slider": "5.2.1",
    "device-search": "file:./modules/device-search",
    "expo": "~58.0.14",
    "expo-app-intents": "~0.5.9",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.8",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-location": "~58.0.17",
    "expo-notifications": "~58.1.5",
    "expo-print": "~58.0.6",
    "expo-router": "~58.0.23",
    "expo-sharing": "~58.0.19",
    "expo-sms": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-updates": "~58.0.17",
    "geomagnetism": "^0.2.0",
    "lucide-react-native": "^1.59.0",
    "proj4": "^2.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "export": "expo export --platform all",
    "verify": "npm run typecheck && npm test && npm run export",
    "deploy:surge": "bash scripts/deploy-surge.sh",
    "content:extract": "node scripts/extract-content.cjs && python3 scripts/build-content.py"
  },
  "expo": {
    "autolinking": {
      "searchPaths": [
        "modules"
      ]
    }
  },
  "private": true,
  "overrides": {
    "react-native": "$react-native",
    "react-native-worklets": "$react-native-worklets"
  }
}
